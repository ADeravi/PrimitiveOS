@import "tailwindcss";
@import "tw-animate-css";

/* ── Radix Color Scales — 29 hue families, 12 steps each, P3/sRGB ───────────
   Light CSS defines variables in :root, .light, .light-theme.
   Dark  CSS redefines the same variables in .dark, .dark-theme.
   When .dark is toggled on <html>, every var(--scale-step) reference
   automatically resolves to the dark value — no manual .dark overrides needed
   for the default (shadcn·Violet) semantic tokens below.
────────────────────────────────────────────────────────────────────────── */
/* Gray families */
@import "@radix-ui/colors/gray.css";
@import "@radix-ui/colors/gray-dark.css";
@import "@radix-ui/colors/mauve.css";
@import "@radix-ui/colors/mauve-dark.css";
@import "@radix-ui/colors/slate.css";
@import "@radix-ui/colors/slate-dark.css";
@import "@radix-ui/colors/sage.css";
@import "@radix-ui/colors/sage-dark.css";
@import "@radix-ui/colors/olive.css";
@import "@radix-ui/colors/olive-dark.css";
@import "@radix-ui/colors/sand.css";
@import "@radix-ui/colors/sand-dark.css";
/* Red family */
@import "@radix-ui/colors/tomato.css";
@import "@radix-ui/colors/tomato-dark.css";
@import "@radix-ui/colors/red.css";
@import "@radix-ui/colors/red-dark.css";
@import "@radix-ui/colors/ruby.css";
@import "@radix-ui/colors/ruby-dark.css";
@import "@radix-ui/colors/crimson.css";
@import "@radix-ui/colors/crimson-dark.css";
/* Pink → Purple */
@import "@radix-ui/colors/pink.css";
@import "@radix-ui/colors/pink-dark.css";
@import "@radix-ui/colors/plum.css";
@import "@radix-ui/colors/plum-dark.css";
@import "@radix-ui/colors/purple.css";
@import "@radix-ui/colors/purple-dark.css";
/* Violet → Indigo */
@import "@radix-ui/colors/violet.css";
@import "@radix-ui/colors/violet-dark.css";
@import "@radix-ui/colors/iris.css";
@import "@radix-ui/colors/iris-dark.css";
@import "@radix-ui/colors/indigo.css";
@import "@radix-ui/colors/indigo-dark.css";
/* Blue → Teal */
@import "@radix-ui/colors/blue.css";
@import "@radix-ui/colors/blue-dark.css";
@import "@radix-ui/colors/cyan.css";
@import "@radix-ui/colors/cyan-dark.css";
@import "@radix-ui/colors/sky.css";
@import "@radix-ui/colors/sky-dark.css";
@import "@radix-ui/colors/teal.css";
@import "@radix-ui/colors/teal-dark.css";
/* Green family */
@import "@radix-ui/colors/mint.css";
@import "@radix-ui/colors/mint-dark.css";
@import "@radix-ui/colors/jade.css";
@import "@radix-ui/colors/jade-dark.css";
@import "@radix-ui/colors/green.css";
@import "@radix-ui/colors/green-dark.css";
@import "@radix-ui/colors/grass.css";
@import "@radix-ui/colors/grass-dark.css";
@import "@radix-ui/colors/lime.css";
@import "@radix-ui/colors/lime-dark.css";
/* Yellow → Brown */
@import "@radix-ui/colors/yellow.css";
@import "@radix-ui/colors/yellow-dark.css";
@import "@radix-ui/colors/amber.css";
@import "@radix-ui/colors/amber-dark.css";
@import "@radix-ui/colors/orange.css";
@import "@radix-ui/colors/orange-dark.css";
@import "@radix-ui/colors/brown.css";
@import "@radix-ui/colors/brown-dark.css";

@custom-variant dark (&:is(.dark *));

/* ---------------------------------------------------------------------------
   Elevation & Motion tokens — mode-independent, unchanged.
--------------------------------------------------------------------------- */
:root {
  --shadow-2xs: 0 1px 2px 0 oklch(0 0 0 / 4%);
  --shadow-xs:  0 1px 2px 0 oklch(0 0 0 / 6%);
  --shadow-sm:  0 1px 3px 0 oklch(0 0 0 / 10%), 0 1px 2px -1px oklch(0 0 0 / 10%);
  --shadow-md:  0 4px 6px -1px oklch(0 0 0 / 10%), 0 2px 4px -2px oklch(0 0 0 / 10%);
  --shadow-lg:  0 10px 15px -3px oklch(0 0 0 / 10%), 0 4px 6px -4px oklch(0 0 0 / 10%);
  --shadow-xl:  0 20px 25px -5px oklch(0 0 0 / 10%), 0 8px 10px -6px oklch(0 0 0 / 10%);

  --duration-instant: 75ms;
  --duration-fast: 150ms;
  --duration-normal: 250ms;
  --duration-slow: 400ms;

  --ease-standard: cubic-bezier(0.2, 0, 0, 1);
  --ease-enter: cubic-bezier(0, 0, 0.2, 1);
  --ease-exit: cubic-bezier(0.4, 0, 1, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ---------------------------------------------------------------------------
   Tier 2 — Semantic tokens (mapped to Radix Color steps)

   Radix step semantics:
     1  App background        7  Interactive element border
     2  Subtle background     8  Hovered border / links
     3  UI element background 9  ★ Solid backgrounds — the vivid accent
     4  Hovered element      10  Hovered solid
     5  Active/selected      11  Low-contrast text
     6  Subtle borders       12  High-contrast text

   Dark mode is fully automatic: Radix dark CSS files redefine every
   --scale-N variable inside .dark, so all var(--slate-*) / var(--violet-*)
   references below resolve to their dark values without any .dark overrides.
   Design-layer presets in preview.tsx override these via inline style on a
   wrapper div — they are unaffected by this Radix-based default.
--------------------------------------------------------------------------- */
:root {
  /* Surfaces — Radix Slate */
  --background:           var(--slate-1);
  --foreground:           var(--slate-12);
  --card:                 var(--slate-2);
  --card-foreground:      var(--slate-12);
  --popover:              var(--slate-2);
  --popover-foreground:   var(--slate-12);
  --muted:                var(--slate-3);
  --muted-foreground:     var(--slate-11);
  --border:               var(--slate-6);
  --input:                var(--slate-6);
  --ring:                 var(--violet-7);

  /* Brand — Radix Violet (step 9 = solid accent) */
  --primary:              var(--violet-9);
  --primary-foreground:   var(--violet-1);
  --secondary:            var(--slate-3);
  --secondary-foreground: var(--slate-12);
  --accent:               var(--violet-3);
  --accent-foreground:    var(--violet-11);

  /* Tier 3 — Functional / status */
  --destructive:          var(--red-9);
  --success:              var(--green-9);
  --success-foreground:   var(--green-1);
  --warning:              var(--amber-9);
  --warning-foreground:   var(--amber-12);
  --info:                 var(--blue-9);
  --info-foreground:      var(--blue-1);

  /* AI provenance — reserved for AI-inferred content only.
     Uses Radix crimson-9 (solid vivid rose-crimson); auto-shifts in dark mode
     via @import "@radix-ui/colors/crimson-dark.css" above.
     Read as var(--rose) in downstream consumers (graph-theme.js, etc.). */
  --rose:                 var(--crimson-9);

  /* Charts — five step-9 colours across distinct hue families */
  --chart-1:              var(--violet-9);
  --chart-2:              var(--cyan-9);
  --chart-3:              var(--amber-9);
  --chart-4:              var(--green-9);
  --chart-5:              var(--red-9);

  --radius: 0.625rem;

  /* Sidebar */
  --sidebar:                    var(--slate-2);
  --sidebar-foreground:         var(--slate-12);
  --sidebar-primary:            var(--violet-9);
  --sidebar-primary-foreground: var(--violet-1);
  --sidebar-accent:             var(--slate-3);
  --sidebar-accent-foreground:  var(--slate-12);
  --sidebar-border:             var(--slate-6);
  --sidebar-ring:               var(--violet-7);
}

/* ---------------------------------------------------------------------------
   Dark mode — Radix handles the heavy lifting.
   The imports above redefine --slate-*, --violet-*, etc. inside .dark
   so every semantic token above automatically gets its dark value.
   Only override tokens that have hardcoded values or need chart-specific
   adjustments for dark surfaces.
--------------------------------------------------------------------------- */
.dark {
  /* No overrides needed: all semantic tokens reference Radix steps and
     auto-shift via the dark CSS imports. */
}

@theme inline {
  --color-background:                   var(--background);
  --color-foreground:                   var(--foreground);
  --color-card:                         var(--card);
  --color-card-foreground:              var(--card-foreground);
  --color-popover:                      var(--popover);
  --color-popover-foreground:           var(--popover-foreground);
  --color-primary:                      var(--primary);
  --color-primary-foreground:           var(--primary-foreground);
  --color-secondary:                    var(--secondary);
  --color-secondary-foreground:         var(--secondary-foreground);
  --color-muted:                        var(--muted);
  --color-muted-foreground:             var(--muted-foreground);
  --color-accent:                       var(--accent);
  --color-accent-foreground:            var(--accent-foreground);
  --color-destructive:                  var(--destructive);
  --color-success:                      var(--success);
  --color-success-foreground:           var(--success-foreground);
  --color-warning:                      var(--warning);
  --color-warning-foreground:           var(--warning-foreground);
  --color-info:                         var(--info);
  --color-info-foreground:              var(--info-foreground);
  --color-rose:                         var(--rose);
  --color-border:                       var(--border);
  --color-input:                        var(--input);
  --color-ring:                         var(--ring);
  --color-chart-1:                      var(--chart-1);
  --color-chart-2:                      var(--chart-2);
  --color-chart-3:                      var(--chart-3);
  --color-chart-4:                      var(--chart-4);
  --color-chart-5:                      var(--chart-5);
  --radius-sm:  calc(var(--radius) - 4px);
  --radius-md:  calc(var(--radius) - 2px);
  --radius-lg:  var(--radius);
  --radius-xl:  calc(var(--radius) + 4px);
  --color-sidebar:                      var(--sidebar);
  --color-sidebar-foreground:           var(--sidebar-foreground);
  --color-sidebar-primary:              var(--sidebar-primary);
  --color-sidebar-primary-foreground:   var(--sidebar-primary-foreground);
  --color-sidebar-accent:               var(--sidebar-accent);
  --color-sidebar-accent-foreground:    var(--sidebar-accent-foreground);
  --color-sidebar-border:               var(--sidebar-border);
  --color-sidebar-ring:                 var(--sidebar-ring);
  /* NOTE: Radix primitive variables (--slate-1..12, --violet-1..12, etc.)
     are intentionally NOT mapped to --color-* here. Use them directly via
     var(--scale-step) in CSS; Tailwind's own utilities use --color-* naming. */
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
}
